# TokenLedger Environment Configuration
# Copy this file to .env and fill in real values

DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/tokenledger
API_KEY=change-me

# Host port mappings for docker compose
# If Windows excludes 5432 or 8000, use 15432 or 8500 respectively.
# Match DB_HOST_PORT in DATABASE_URL and in the TEST_DATABASE_URL exported for pytest.
DB_HOST_PORT=5432
API_HOST_PORT=8000
DASHBOARD_HOST_PORT=8501

# Compose uses http://api:8000 by default.
# Set API_BASE_URL in your shell when running Streamlit directly on the host.

