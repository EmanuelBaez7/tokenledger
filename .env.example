# TokenLedger Environment Configuration
# Copy this file to .env and fill in real values

DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/tokenledger
API_KEY=change-me

# Host port mappings for docker compose
# Note for Windows users: if ports 7918-8217 are reserved, set API_HOST_PORT=8500
API_HOST_PORT=8000
DASHBOARD_HOST_PORT=8501

# Dashboard API connection
API_BASE_URL=http://localhost:8000

